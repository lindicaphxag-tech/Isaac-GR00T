{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lindicaphxag-tech/Isaac-GR00T/semrepair-v0.3-rc1/semrepair_validation/schemas/adoption-manifest-v1.schema.json",
  "title": "SemRepair adoption manifest v1",
  "type": "object",
  "required": [
    "schema_version",
    "repository",
    "integration_type",
    "semantic_layer",
    "contract_ids",
    "maintained_path",
    "status",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "integration_type": {
      "enum": ["native-regression", "source-boundary-ci", "runtime-refinement"]
    },
    "semantic_layer": {"type": "string", "minLength": 1},
    "contract_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "maintained_path": {"type": "string", "minLength": 1},
    "status": {"enum": ["candidate", "maintained"]},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
